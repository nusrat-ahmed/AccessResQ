# Generate a long random secret for any deployed environment.
ACCESSRESQ_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
# Optional token used to review reports and manage/verify shelters.
ACCESSRESQ_ADMIN_TOKEN=replace-with-a-different-long-random-secret
# Optional paths. On a cloud host, point both to persistent disk storage.
# ACCESSRESQ_DB_PATH=/var/data/accessresq.db
# ACCESSRESQ_UPLOAD_DIR=/var/data/uploads
# ENVIRONMENT=production

# Optional standalone gateway token for future LoRa/serial receiver -> HTTP bridge.
ACCESSRESQ_RELAY_TOKEN=replace-with-a-third-different-long-random-secret
